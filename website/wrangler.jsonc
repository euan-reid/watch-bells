{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "watchbells-site",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "www.watchbells.com",
      "custom_domain": true,
    },
  ],
  "workers_dev": false,
  "preview_urls": true,
}
